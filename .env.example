POSTGRES_DB=haiqu_erp
POSTGRES_USER=haiqu
POSTGRES_PASSWORD=<本地开发密码>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=15432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=16379
REDIS_URL=redis://redis:6379/0

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=15
CONTACT_IMPORT_MAX_BYTES=5242880
CONTACT_IMPORT_MAX_ROWS=500
BOM_IMPORT_MAX_BYTES=104857600

# 账户级 SMTP 授权码加密密钥。请使用 Fernet 生成的 URL-safe base64 密钥；
# 多个密钥以逗号分隔，首个用于加密，后续用于轮换期解密。
EMAIL_ACCOUNT_FERNET_KEYS=<使用 cryptography.fernet.Fernet.generate_key() 生成>

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=<本地开发SECRET_KEY>
DEV_AUTO_LOGIN_ENABLED=False
DEV_AUTO_LOGIN_USERNAME=admin
DEV_AUTO_LOGIN_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
LAN_IP=192.168.1.100
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,192.168.1.100
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://192.168.1.100:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://192.168.1.100:8080

VITE_API_BASE_URL=http://192.168.1.100:8000
VITE_FIXED_LOGIN_ENABLED=false

# New permission gates stay off until staged acceptance and approved initialization.
ACCESS_MANAGEMENT_ENABLED=false
SALES_ACCESS_ENABLED=false
MODULE_ACCESS_ENABLED=false
# Enable only after access_control.0006 and isolated resource-scope acceptance.
ACCESS_RESOURCE_SCOPES_ENABLED=false
WORK_REPORT_DELETION_ENABLED=false
WORK_REPORT_HISTORY_ENABLED=false
