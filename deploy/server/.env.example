# 复制到 /etc/haiqu-erp/server.env 后填入真实值，文件权限设为 600；不要提交真实文件。
RELEASE_TAG=REPLACE_WITH_RELEASE_TAG
ERP_BUILD_CONTEXT=/opt/haiqu-erp/releases/REPLACE_WITH_RELEASE_TAG
ERP_ENV_FILE=/etc/haiqu-erp/server.env

POSTGRES_DB=haiqu_erp
POSTGRES_USER=haiqu_erp
POSTGRES_PASSWORD=REPLACE_WITH_INDEPENDENT_DATABASE_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=15
FILE_VIRUS_SCAN_ENABLED=true
DJANGO_SECRET_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_AT_LEAST_50_CHARACTERS

# 现有邮件加密密钥和业务功能开关必须从当前环境按实际值迁移，不用模板覆盖。
EMAIL_ACCOUNT_FERNET_KEYS=
