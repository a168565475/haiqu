FROM public.ecr.aws/docker/library/python:3.13-slim AS dependencies

ENV PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build
COPY backend/requirements/ ./requirements/
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir \
        -r requirements/base.txt gunicorn==26.2.0

FROM public.ecr.aws/docker/library/python:3.13-slim

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=config.settings_server

WORKDIR /app
COPY --from=dependencies /opt/venv /opt/venv
COPY backend/ /app/
COPY deployment/settings_server.py /app/config/settings_server.py
RUN groupadd --gid 10001 erp \
    && useradd --uid 10001 --gid 10001 --no-create-home erp \
    && mkdir -p /app/media /app/staticfiles \
    && chown 10001:10001 /app/media /app/staticfiles

USER 10001:10001
EXPOSE 8000

CMD ["sh", "-c", "python wait_for_services.py && python manage.py collectstatic --noinput && exec gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers 2 --timeout 120 --access-logfile - --error-logfile -"]
